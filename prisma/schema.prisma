generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  gallery_owner
  employee
  craftsman
  user
}

enum ProductStatus {
  draft
  active
  archived
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  firstName String?
  lastName  String?
  slug      String?
  phone     String?
  avatar    String?
  role      Role     @default(user)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownedGallery     Gallery?       @relation("GalleryOwner")
  employeeProfile  Employee?      @relation("EmployeeProfile")
  craftsmanProfile Craftsman?     @relation("CraftsmanProfile")
  createdProducts  Product[]      @relation("ProductCreator")
  wishlistItems    WishlistItem[] @relation("UserWishlist")
  cart             Cart?          @relation("UserCart")
  orders           Order[]        @relation("UserOrders")

  @@index([role])
}

model Gallery {
  id            String   @id @default(uuid())
  name          String
  slug          String   @unique
  description   String?
  mapAddressUrl String?
  phone         String?
  country       String?
  city          String?
  street        String?
  logo          String?
  images        String[]
  banner        String?
  storageFolder String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  ownerId String @unique
  owner   User   @relation("GalleryOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  employees Employee[] @relation("GalleryEmployees")
  products  Product[]  @relation("GalleryProducts")
  orders    Order[]    @relation("GalleryOrders")

  @@index([ownerId])
}

model Employee {
  id        String   @id @default(uuid())
  userId    String   @unique
  galleryId String
  title     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation("EmployeeProfile", fields: [userId], references: [id], onDelete: Cascade)
  gallery Gallery @relation("GalleryEmployees", fields: [galleryId], references: [id], onDelete: Cascade)

  @@index([galleryId])
}

model Product {
  id             String        @id @default(uuid())
  galleryId      String
  createdById    String
  categoryId     String
  name           String
  mainImageUrl   String?
  images         String[]
  slug           String
  description    String?
  price          Decimal       @db.Decimal(10, 2)
  compareAtPrice Decimal?      @db.Decimal(10, 2)
  stock          Int           @default(0)
  status         ProductStatus @default(active)
  materials      String[]
  dimensions     String?
  isFeatured     Boolean       @default(false)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  gallery   Gallery @relation("GalleryProducts", fields: [galleryId], references: [id], onDelete: Cascade)
  createdBy User    @relation("ProductCreator", fields: [createdById], references: [id], onDelete: Restrict)
  category  Category @relation("CategoryProducts", fields: [categoryId], references: [id], onDelete: Cascade)

  wishlistedBy WishlistItem[] @relation("ProductWishlists")
  cartItems    CartItem[]     @relation("ProductCartItems")
  orderItems   OrderItem[]    @relation("ProductOrderItems")

  @@unique([galleryId, slug])
  @@index([galleryId, status])
  @@index([name])
}

model Category {
  id        String   @id @default(uuid())
  name      String
  arabicName String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[] @relation("CategoryProducts")
}

model Craftsman {
  id           String   @id @default(uuid())
  userId       String   @unique
  displayName  String?
  specialty    String?
  bio          String?
  portfolioUrl String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation("CraftsmanProfile", fields: [userId], references: [id], onDelete: Cascade)
}

enum OrderStatus {
  pending
  accepted
  rejected
  cancelled
}

model WishlistItem {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation("UserWishlist", fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation("ProductWishlists", fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model Cart {
  id        String   @id @default(uuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation("UserCart", fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  productId String
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation("ProductCartItems", fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
}

model Order {
  id              String      @id @default(uuid())
  userId          String
  galleryId       String
  status          OrderStatus @default(pending)
  totalPrice      Decimal     @db.Decimal(12, 2)
  shippingAddress Json?
  note            String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user    User        @relation("UserOrders", fields: [userId], references: [id], onDelete: Restrict)
  gallery Gallery     @relation("GalleryOrders", fields: [galleryId], references: [id], onDelete: Restrict)
  items   OrderItem[]

  @@index([userId])
  @@index([galleryId, status])
}

model OrderItem {
  id          String  @id @default(uuid())
  orderId     String
  productId   String
  productName String
  imageUrl    String?
  unitPrice   Decimal @db.Decimal(10, 2)
  quantity    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation("ProductOrderItems", fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
}
