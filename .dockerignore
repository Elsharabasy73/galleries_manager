# Keep the build context small, reproducible and secret-free.
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

.git
.gitignore
.github
.claude

.env
.env.*
!.env.example

coverage
.nyc_output
*.lcov

test
tests
__tests__

docs
*.md
!README.md

.vscode
.idea

logs
*.log
pids
*.pid

.next
.nuxt
dist
out
build

# Runtime uploads are a mounted volume in production — never bake them in.
storage/uploads/*
!storage/uploads/users/.gitkeep
!storage/uploads/galleries/.gitkeep
!storage/uploads/products/.gitkeep

# Local tooling / caches
.npm
.eslintcache
.cache
.parcel-cache

# Local compose overrides (prod file is explicit and versioned)
docker-compose.override.yml
