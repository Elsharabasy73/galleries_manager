# Copy to /opt/galleries_manager/.env.prod on EC2 (chmod 600). NEVER commit the real file.
# Local dev: copy to .env instead.

NODE_ENV=production
PORT=3000

# Public origin of the API (used for absolute URLs, e.g. served files / email assets)
APP_URL=http://<ec2-public-ip-or-domain>:3000

# Docker image deployed by the CD pipeline (set automatically per release)
IMAGE=ghcr.io/<owner>/galleries_manager:latest

# --- Postgres (compose service) ---
POSTGRES_DB=galleries_manager
POSTGRES_USER=galleries
POSTGRES_PASSWORD=change-me-to-a-long-random-secret
# App connects via the internal compose hostname, not localhost:
DATABASE_URL=postgresql://galleries:change-me-to-a-long-random-secret@postgres:5432/galleries_manager

# --- Redis (compose service) ---
REDIS_URL=redis://redis:6379

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=1h

# --- Email ---
RESEND_API_KEY=change-me
RESEND_FROM=noreply@example.com
CODE_EXPIRES_IN=60

# --- Email provider selection (see src email service) ---
# SENDER=RESEND
# SENDER_HOST=
# SENDER_PORT=
# SENDER_SECURE=
# SENDER_EMAIL=
# SENDER_PASSWORD=
